# Переменные
HELM_RELEASE_NAME := flask-test1
VALUES_FILE := ./values.yaml
IMAGENAME := hevdin/flask-test
HELM_DIR=./
APP_LABLE := flask-test
APP_SERVICEACCOUNT := flask-test
APP_NAMESPACE := default

# Динамическое получение последнего Git commit hash
IMAGETAG := $(shell git rev-parse --short HEAD)

# Флаги для Helm
HELM_FLAGS := --set image.tag=$(IMAGETAG)
              
# Цель для установки/обновления Helm-чарта
#helm-deploy:
#	helm upgrade --install $(HELM_RELEASE_NAME) $(HELM_DIR) -f $(VALUES_FILE) $(HELM_FLAGS)

# --- Оно поломает арго --- Генерация values.yaml с использованием Git commit hash
#helm-generate-values:
#	truncate -s 0 $(VALUES_FILE)
#	echo "#values.yaml generated by Makefile" >> $(VALUES_FILE)
#	echo "name: $(HELM_RELEASE_NAME)" >> $(VALUES_FILE)
#	echo "app_type: $(APP_LABLE)" >> $(VALUES_FILE)
#	echo "image:" >> $(VALUES_FILE)
#	echo "  repository: $(IMAGENAME)" >> $(VALUES_FILE)
#	echo "  tag: $(IMAGETAG)" >> $(VALUES_FILE)
#	echo "serviceAccount:\n  create: true\n  name: $(APP_SERVICEACCOUNT)\n" >> $(VALUES_FILE)
#	echo "namespace: $(APP_NAMESPACE) >> $(VALUES_FILE)"

# Развертывание сервиса приложения типа master (метка service_type = master)
helm-master-deploy:
	truncate -s 0 $(VALUES_FILE)
	echo "#values.yaml generated by Makefile" >> $(VALUES_FILE)
	echo "name: flask-test-master-release" >> $(VALUES_FILE)
	echo "app_type: $(APP_LABLE)" >> $(VALUES_FILE)
	echo "service_type: flask-test-master" >> $(VALUES_FILE)
	echo "role: flasktest-master" >> $(VALUES_FILE)
	echo "role_binding: flasktest-master" >> $(VALUES_FILE)
	echo "clusterrole: flasktest-master" >> $(VALUES_FILE)
	echo "clustrole_binding: flasktest-master" >> $(VALUES_FILE)
	echo "port: 8080" >> $(VALUES_FILE)
	echo "targetport: 8080" >> $(VALUES_FILE)
	echo "nodeport: 30002" >> $(VALUES_FILE)
	echo "image:" >> $(VALUES_FILE)
	echo "  repository: $(IMAGENAME)" >> $(VALUES_FILE)
	echo "  tag: $(IMAGETAG)" >> $(VALUES_FILE)
	echo "namespace: $(APP_NAMESPACE)" >> $(VALUES_FILE)
	echo "service_name: flask-test-master" >> $(VALUES_FILE)
	echo "serviceAccount:\n  create: true\n  name: flask-test-master\n" >> $(VALUES_FILE)
	helm upgrade --install flask-test-master-release $(HELM_DIR) -f $(VALUES_FILE) $(HELM_FLAGS)

# Развертывание сервиса приложения типа worker (метка service_type = worker)
helm-worker-deploy:
	truncate -s 0 $(VALUES_FILE)
	echo "#values.yaml generated by Makefile" >> $(VALUES_FILE)
	echo "name: flask-test-worker-release" >> $(VALUES_FILE)
	echo "app_type: $(APP_LABLE)" >> $(VALUES_FILE)
	echo "service_type: flask-test-worker" >> $(VALUES_FILE)
	echo "role: flasktest-worker" >> $(VALUES_FILE)
	echo "role_binding: flasktest-worker" >> $(VALUES_FILE)
	echo "clusterrole: flasktest-worker" >> $(VALUES_FILE)
	echo "clustrole_binding: flasktest-worker" >> $(VALUES_FILE)
	echo "port: 8080" >> $(VALUES_FILE)
	echo "targetport: 8080" >> $(VALUES_FILE)
	echo "nodeport: 30001" >> $(VALUES_FILE)
	echo "image:" >> $(VALUES_FILE)
	echo "  repository: $(IMAGENAME)" >> $(VALUES_FILE)
	echo "  tag: $(IMAGETAG)" >> $(VALUES_FILE)
	echo "namespace: $(APP_NAMESPACE)" >> $(VALUES_FILE)
	echo "service_name: flask-test-worker" >> $(VALUES_FILE)
	echo "serviceAccount:\n  create: true\n  name: flask-test-worker\n" >> $(VALUES_FILE)
	helm upgrade --install flask-test-worker-release $(HELM_DIR) -f $(VALUES_FILE) $(HELM_FLAGS)

# Полный процесс: генерация values.yaml + деплой
helm-full-deploy: helm-generate-values helm-deploy
